{
  "expo": {
    "name": "ScriptVault",
    "slug": "mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1117"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ScriptVault needs microphone access to record voice notes.",
        "NSPhotoLibraryUsageDescription": "ScriptVault needs access to your photo library to attach video notes.",
        "NSPhotoLibraryAddUsageDescription": "ScriptVault needs access to save media files."
      },
      "bundleIdentifier": "com.changitsolutions.scripttracker"
    },
    "android": {
      "versionCode": 3,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "com.changitsolutions.scripttracker"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "ScriptVault needs microphone access to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ScriptVault needs access to your photo library to attach video notes.",
          "cameraPermission": "ScriptVault needs access to your camera to attach video notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "31a1caaa-6182-432a-8983-1db8dc072d2d"
      }
    }
  }
}